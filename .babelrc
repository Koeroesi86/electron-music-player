{
  "presets": [
    ["@babel/preset-env", { "targets": { "electron": "30" } }],
    "@babel/preset-typescript"
  ],
  "overrides": [
    {
      "test": ["./**/*.tsx", "./**/*.jsx", "./**/*.js"],
      "presets": ["@babel/preset-react"]
    }
  ],
  "plugins": [
    "@babel/plugin-transform-runtime"
  ]
}
