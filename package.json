{
  "name": "electron-music-player",
  "version": "1.0.0",
  "description": "Lossless Audio Player",
  "main": "out/index.js",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/prebuild.js",
    "postinstall": "node scripts/postinstall.js",
    "dev": "node scripts/prebuild.js && node scripts/tsc.js tsconfig.main.json out && node --max_old_space_size=2048 scripts/start.js",
    "build": "node scripts/tsc.js tsconfig.main.json out && node scripts/build.js",
    "start": "electron out/index.js",
    "dist": "node scripts/dist.js",
    "typecheck": "node scripts/tsc.js tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backend": "vitest run --project backend",
    "test:frontend": "vitest run --project frontend",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --cache --cache-strategy content --cache-location .cache/eslint/ .",
    "lint:fix": "eslint --fix .",
    "fallow": "fallow",
    "security:electron": "node scripts/security-scan.js",
    "smoke": "node scripts/smoke.js",
    "smoke:packaged": "node scripts/smoke.js --packaged",
    "smoke:flatpak": "node scripts/smoke.js --flatpak",
    "check:dist": "node scripts/check-dist.js"
  },
  "author": {
    "name": "Krisztian Korosi",
    "email": "koeroesi86@gmail.com",
    "url": "http://chris.koro.si"
  },
  "homepage": "https://github.com/Koeroesi86/electron-music-player",
  "build": {
    "appId": "io.github.koeroesi86.eMusic",
    "productName": "eMusic",
    "compression": "normal",
    "files": [
      "build/**/*",
      "out/**/*",
      "node_modules/**/*",
      "icons/**/*",
      "assets/**/*",
      "config/**/*",
      "migrations/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.{spec,test}.*"
    ],
    "asarUnpack": [
      "**/node_modules/@img/**"
    ],
    "win": {
      "icon": "icons/win/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icons/mac/icon.icns"
    },
    "nsis": {
      "artifactName": "eMusic-Setup-${version}.${ext}"
    },
    "linux": {
      "artifactName": "eMusic-${version}.${ext}",
      "executableName": "eMusic",
      "category": "Audio",
      "target": [
        "AppImage"
      ],
      "icon": "icons/png/"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "publish": {
      "provider": "github",
      "owner": "Koeroesi86",
      "repo": "electron-music-player"
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "25.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "25.08",
      "useWaylandFlags": true,
      "finishArgs": [
        "--socket=wayland",
        "--socket=x11",
        "--share=ipc",
        "--device=dri",
        "--socket=pulseaudio",
        "--share=network",
        "--filesystem=xdg-music:ro"
      ]
    }
  },
  "license": "ISC",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "mime-types": "^3.0.2",
    "minimist": "^1.2.8",
    "music-metadata": "^12.2.3",
    "playlist-parser": "^0.0.12",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "sqlite3": "^6.0.1",
    "windows-shortcuts-appid": "^0.3.2"
  },
  "devDependencies": {
    "@doyensec/electronegativity": "^1.10.3",
    "@electron/asar": "^4.3.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^5.0.5",
    "classnames": "^2.5.1",
    "css-loader": "^7.1.5",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild-loader": "^4.5.0",
    "eslint": "^10.13.0",
    "eslint-plugin-prettier": "^5.5.7",
    "fallow": "^3.34.1",
    "file-loader": "^6.2.0",
    "jsdom": "^30.1.3",
    "path-browserify": "^1.0.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1",
    "rimraf": "^6.1.3",
    "sass": "^1.105.2",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.1.0"
  },
  "overrides": {
    "tar": "^7.5.22",
    "xmldom": "npm:@xmldom/xmldom@^0.9.12"
  }
}
