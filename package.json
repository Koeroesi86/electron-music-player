{
  "name": "electron-music-player",
  "version": "1.0.0",
  "description": "Lossless Audio Player",
  "main": "index.js",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/prebuild.js",
    "postinstall": "node scripts/postinstall.js",
    "dev": "node scripts/prebuild.js && node --max_old_space_size=2048 scripts/start.js",
    "build": "node scripts/build.js",
    "start": "electron index.js",
    "dist": "node scripts/dist.js"
  },
  "author": {
    "name": "Krisztian Korosi",
    "email": "koeroesi86@gmail.com",
    "url": "http://chris.koro.si"
  },
  "homepage": "https://github.com/Koeroesi86/electron-music-player",
  "build": {
    "appId": "com.squirrel.emusic",
    "productName": "eMusic",
    "compression": "normal",
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "electron/**/*",
      "icons/**/*",
      "assets/**/*",
      "config/**/*",
      "migrations/**/*",
      "index.js",
      "package.json"
    ],
    "win": {
      "icon": "icons/win/icon.ico",
      "target": [
        "nsis",
        "msi",
        "zip"
      ]
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icons/mac/icon.icns"
    },
    "linux": {
      "artifactName": "eMusic-${version}.${ext}",
      "executableName": "eMusic",
      "category": "Audio",
      "target": [
        "AppImage",
        "snap",
        "deb",
        "rpm",
        "freebsd",
        "pacman",
        "p5p",
        "apk",
        "7z",
        "zip",
        "tar.gz"
      ],
      "icon": "icons/png/"
    },
    "publish": {
      "provider": "generic",
      "url": "http://localhost",
      "channel": "latest",
      "publishAutoUpdate": true
    }
  },
  "license": "ISC",
  "dependencies": {
    "@babel/runtime": "^7",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "classnames": "^2.5.1",
    "electron-window-state": "^5.0.3",
    "express": "^5.3.0",
    "find-free-port": "^2.0.0",
    "in-view": "^0.6.1",
    "lodash": "^4.18.1",
    "mime-types": "^3.0.2",
    "minimist": "^1.2.8",
    "moment": "^2.31.0",
    "music-metadata": "^12.2.2",
    "playlist-parser": "^0.0.12",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-addons-shallow-compare": "^15.6.3",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "sqlite3": "^6.0.1",
    "ssh2-sftp-client": "^12.1.1",
    "windows-shortcuts-appid": "^0.3.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/plugin-transform-runtime": "^8.0.6",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-icon-maker": "^0.0.5",
    "electron-packager": "^17.1.2",
    "eslint": "^10.13.0",
    "exports-loader": "^5.0.0",
    "file-loader": "^6.2.0",
    "imports-loader": "^5.0.0",
    "mini-css-extract-plugin": "^2.10.2",
    "neostandard": "^0.14.1",
    "path-browserify": "^1.0.1",
    "rimraf": "^6.1.3",
    "sass": "^1.105.2",
    "sass-loader": "^17.0.1",
    "static-site-generator-webpack-plugin": "^3.4.2",
    "style-loader": "^4.0.0",
    "url-loader": "^4.1.1",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  }
}
